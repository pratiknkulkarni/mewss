# mewsss/env.example
#
# For docker-compose.yaml, which builds every service from source. The defaults
# suit local development; see env.prod.example for the published-image stack.
#
#   cp env.example .env

# ── Postgres ──────────────────────────────────────────────────────────────────
POSTGRES_USER=mewss_user
POSTGRES_PASSWORD=changeme          # change this
POSTGRES_DB=mewss
POSTGRES_PORT=5432

# ── Where the app is reachable ────────────────────────────────────────────────
# Host port the client is published on by docker-compose.yaml.
MEWSS_PORT=8080

# ── Better Auth ───────────────────────────────────────────────────────────────
# Required. Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=

# Both of these are the URL the *browser* uses, and under compose that is the
# client's port, not the API's — nginx proxies /api, so the two share one origin.
# They are passed straight through to the API container, so getting them wrong
# here is the silent-login-failure case: the request succeeds, the cookie is
# scoped to an origin the browser never visits, and nothing is logged.
#
# Keep both in sync with MEWSS_PORT above. Only running `bun dev` outside Docker
# wants the split values (http://localhost:3000 for the API, http://localhost:5173
# for Vite).
BETTER_AUTH_URL=http://localhost:8080
FRONTEND_URL=http://localhost:8080

# ── Scheduler (local dev only) ────────────────────────────────────────────────
# Inside Docker Compose this is overridden to http://mewss-scheduler:8081
# automatically. Only needed when running `bun dev` outside Docker.
SCHEDULER_URL=http://localhost:8081

# ── Logging ───────────────────────────────────────────────────────────────────
APP_ENV=development       # development | production
NODE_ENV=development      # development | production
LOG_LEVEL=info            # debug | info | warn | error
APPLICATION_NAME=mewss_api


# ── Internal API Secret ───────────────────────────────────────────────────────
# Required. Shared secret the API sends as X-Internal-Secret when calling the
# scheduler. The scheduler refuses to start if this is empty.
# Generate with: openssl rand -hex 32
INTERNAL_API_SECRET=
