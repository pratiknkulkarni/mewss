# feedscheduler — environment configuration
# ─────────────────────────────────────────
# This file documents every environment variable the application reads.
# It is committed to version control — do not put real credentials here.
#
# To get started locally:
#   cp .env.example .env
#   # edit .env with your actual values
#   make run          # run without Docker
#   docker compose up --build   # run with Docker

# ── Postgres ──────────────────────────────────────────────────────────────────
# These three are used by the postgres container itself (docker-compose reads
# them directly). They are also interpolated into DATABASE_URL below so you
# only need to change a password in one place.
POSTGRES_USER=feedscheduler_user
POSTGRES_PASSWORD=changeme
POSTGRES_DB=feedscheduler_db

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development    # development | production  (controls log format: text vs JSON)
LOG_LEVEL=debug        # debug | info | warn | error

# When running via `make run` (no Docker), set this directly.
# When running via docker compose, this is constructed automatically from the
# Postgres vars above — you do not need to set it manually in that case.
DATABASE_URL=postgresql://feedscheduler_user:changeme@localhost:5432/feedscheduler_db?sslmode=disable

# ── Worker knobs (optional — defaults shown) ──────────────────────────────────
# Uncomment and change only what you need to tune. The defaults are sensible
# for a single-node deployment polling a moderate number of feeds.
#
# WORKER_COUNT=5             # number of concurrent feed-fetching goroutines
# POLL_INTERVAL=10s          # how often the scheduler checks for due feeds
# STALE_LOCK_CUTOFF=15m      # how long before a stuck feed lock is force-released
# DB_MAX_OPEN_CONNS=25       # max open postgres connections
# DB_MAX_IDLE_CONNS=25       # max idle postgres connections kept in the pool
# DB_CONN_MAX_LIFETIME=5m    # max time a connection is reused before being closed
# API_PORT=:8081             # port the internal HTTP API listens on