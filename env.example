# mewss/.env.example
#
# Copy to .env and fill in the values marked as required.
# The defaults shown are suitable for local development.
#
#   cp .env.example .env

# ── Postgres ──────────────────────────────────────────────────────────────────
POSTGRES_USER=mewss_user
POSTGRES_PASSWORD=changeme          # change this
POSTGRES_DB=mewss
POSTGRES_PORT=5432

# ── Better Auth ───────────────────────────────────────────────────────────────
# Required. Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=

# URL this API is reachable at (used for cookie domain and OAuth callbacks)
BETTER_AUTH_URL=http://localhost:3000

# ── CORS / Frontend ───────────────────────────────────────────────────────────
# URL of the React frontend.
# In dev with Vite proxy configured, this can be left blank.
FRONTEND_URL=http://localhost:5173

# ── Scheduler (local dev only) ────────────────────────────────────────────────
# Inside Docker Compose this is overridden to http://mewss-scheduler:8081
# automatically. Only needed when running `bun dev` outside Docker.
SCHEDULER_URL=http://localhost:8081

# ── Logging ───────────────────────────────────────────────────────────────────
APP_ENV=development       # development | production
NODE_ENV=development      # development | production
LOG_LEVEL=info            # debug | info | warn | error
APPLICATION_NAME=mewss_api


# ── Internal API Secret ───────────────────────────────────────────────────────────────────
# Required. Generate with: openssl rand -hex 32. Required to protect the Go API.
INTERNAL_API_SECRET=django
