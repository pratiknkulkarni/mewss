# Database
# Full Postgres connection string. This is the only DATABASE_* variable needed.
DATABASE_URL=postgresql://user:password@localhost:5432/mewss

# Better Auth
# Min 32 characters. Generate with: "openssl rand -hex 32"
BETTER_AUTH_SECRET=

# The URL this API is reachable at. Used by Better Auth for cookie domain and
# OAuth callbacks. In dev: http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000

# CORS
# URL of the React frontend. Added to Better Auth's trustedOrigins.
# In dev with Vite proxy this can be omitted — requests arrive same-origin.
FRONTEND_URL=http://localhost:5173

# Go Scheduler
# Internal URL of the feedscheduler service.
# Docker Compose: http://feedscheduler:8081
# Local dev (scheduler running directly): http://localhost:8081
SCHEDULER_URL=http://localhost:8081

# Logging
# debug | info | warn | error  (default: info)
LOG_LEVEL=info

# development | production  (controls pino-pretty vs JSON output)
NODE_ENV=development

# Optional label attached to every log line
APPLICATION_NAME=mewss_api