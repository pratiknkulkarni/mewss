### Variables
@baseUrl = http://localhost:3000
@origin = http://localhost:3000
@email = django@catmail.com
@password = django@catmail.com


### ========================================
### AUTH
### ========================================

### Sign up
POST {{baseUrl}}/api/auth/sign-up/email
Content-Type: application/json
Origin: {{origin}}

{
  "name": "Test User",
  "email": "{{email}}",
  "password": "{{password}}"
}


### Sign in
# @name signIn
POST {{baseUrl}}/api/auth/sign-in/email
Content-Type: application/json
Origin: {{origin}}

{
  "email": "{{email}}",
  "password": "{{password}}"
}


### Get current session
GET {{baseUrl}}/api/auth/get-session
Origin: {{origin}}


### Sign out
POST {{baseUrl}}/api/auth/sign-out
Origin: {{origin}}

### ========================================
### FEEDS
### ========================================

### List all feeds
GET {{baseUrl}}/api/feeds
Origin: {{origin}}


### List feeds filtered by status
GET {{baseUrl}}/api/feeds?status=active
Origin: {{origin}}


### Get a single feed
GET {{baseUrl}}/api/feeds/24a0bce9-0e37-4429-a7cd-02392a2260fe
Origin: {{origin}}


### Add a new feed
# @name createFeed
POST {{baseUrl}}/api/feeds
Content-Type: application/json
Origin: {{origin}}

{
  "url": "https://rss.nytimes.com/services/xml/rss/nyt/HomePage.xml",
  "refreshInterval": "24h"
}

### Delete a feed
DELETE {{baseUrl}}/api/feeds/24a0bce9-0e37-4429-a7cd-02392a2260fe
Origin: {{origin}}

### Add a feed — validation error (bad URL)
POST {{baseUrl}}/api/feeds
Content-Type: application/json
Origin: {{origin}}

{
  "url": "not-a-url",
  "refreshInterval": "30m"
}


### VALIDATION ERROR (interval too short) - Add a feed
POST {{baseUrl}}/api/feeds
Content-Type: application/json
Origin: {{origin}}

{
  "url": "https://feeds.feedburner.com/TheHackersNew",
  "refreshInterval": "1m"
}

### VALIDATION ERROR (url not valid) - Add a feed
POST {{baseUrl}}/api/feeds
Content-Type: application/json
Origin: {{origin}}

{
  "url": "https://www.thehindu.com/business/Economy/feeder/default.rss",
  "refreshInterval": "100m"
}

### Trigger manual refresh
POST {{baseUrl}}/api/feeds/475d93b1-9a8e-4bf6-9abe-a2e2a00a9407/refresh
Origin: {{origin}}

### List articles for a feed (defaults: page=1, limit=10)
GET {{baseUrl}}/api/feeds/914dec1b-31bf-4bf0-bb14-6e490ef2ca24/articles?unread=true&limit=1&page=1
Origin: {{origin}}


### List articles for a feed — page 2
GET {{baseUrl}}/api/feeds/23cafaf6-a7ae-4676-9f89-a039477da92d/articles?page=3&limit=10
Origin: {{origin}}


### List unread articles for a feed
GET {{baseUrl}}/api/feeds/fde60409-964f-4305-a9e2-6c8ef5cccddd/articles?unread=true
Origin: {{origin}}


### Global inbox — all articles across all feeds
GET {{baseUrl}}/api/articles
Origin: {{origin}}


### Global inbox — unread only
GET {{baseUrl}}/api/articles?unread=true
Origin: {{origin}}


### Global inbox — filtered to a specific feed
GET {{baseUrl}}/api/articles?feedId=<FEED_ID>
Origin: {{origin}}


### Global inbox — unread in a specific feed
GET {{baseUrl}}/api/articles?feedId=fde60409-964f-4305-a9e2-6c8ef5cccddd&unread=true
Origin: {{origin}}


### Mark a single article as read
PATCH {{baseUrl}}/api/articles/<ARTICLE_ID>/read
Origin: {{origin}}


### Mark all articles in a feed as read
POST {{baseUrl}}/api/feeds/6fcedf70-00be-4911-b6ae-2985a6cea572/articles/read-all
Origin: {{origin}}


### Mark all articles across all feeds as read
POST {{baseUrl}}/api/articles/read-all
Origin: {{origin}}


### NOT FOUND — articles for non-existent feed
GET {{baseUrl}}/api/feeds/00000000-0000-0000-0000-000000000000/articles
Origin: {{origin}}


### NOT FOUND — mark non-existent article as read
PATCH {{baseUrl}}/api/articles/00000000-0000-0000-0000-000000000000/read
Origin: {{origin}}


### VALIDATION ERROR — limit above max (100)
GET {{baseUrl}}/api/feeds/<FEED_ID>/articles?limit=200
Origin: {{origin}}


### VALIDATION ERROR — page below minimum (1)
GET {{baseUrl}}/api/feeds/<FEED_ID>/articles?page=0
Origin: {{origin}}


### Export all subscriptions as OPML
# Downloads as mewss-subscriptions-YYYY-MM-DD.opml
GET {{baseUrl}}/api/export/opml
Origin: {{origin}}


### Import subscriptions from an OPML file
# Replace <path> with the absolute path to your .opml file on disk.
# In IntelliJ/WebStorm: use the file picker via the paperclip icon next to the body.
POST {{baseUrl}}/api/import/opml
Origin: {{origin}}
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="file"; filename="subscriptions.opml"
Content-Type: text/xml

<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
    <head>
        <title>mewss subscriptions</title>
        <dateCreated>Mon, 04 May 2026 04:56:43 GMT</dateCreated>
    </head>
    <body>
        <outline type="rss" text="/r/Technology" title="/r/Technology" xmlUrl="https://reddit.com/r/technology/.rss"
                 description="Subreddit dedicated to the news and discussions about the creation and use of technology and its surrounding issues."/>
    </body>
</opml>

--boundary--


### Import OPML with folder groupings (folders are flattened, feeds are imported)
POST {{baseUrl}}/api/import/opml
Origin: {{origin}}
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="file"; filename="grouped.opml"
Content-Type: text/xml

<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head><title>grouped feeds</title></head>
  <body>
    <outline text="Tech">
      <outline type="rss" text="Ars Technica" xmlUrl="https://feeds.arstechnica.com/arstechnica/index"/>
      <outline type="rss" text="Wired"        xmlUrl="https://www.wired.com/feed/rss"/>
    </outline>
    <outline text="News">
      <outline type="rss" text="BBC" xmlUrl="https://feeds.bbci.co.uk/news/rss.xml"/>
    </outline>
  </body>
</opml>
--boundary--


### Export starred articles as JSON (default)
# Downloads as mewss-starred-YYYY-MM-DD.json
# Response shape: { exported: number, articles: Article[] }
GET {{baseUrl}}/api/export/starred
Origin: {{origin}}


### Export starred articles as JSON (explicit)
GET {{baseUrl}}/api/export/starred?format=json
Origin: {{origin}}


### Export starred articles as CSV
# Downloads as mewss-starred-YYYY-MM-DD.csv
# Columns: id,title,url,author,publishedAt,feedId,starredAt
GET {{baseUrl}}/api/export/starred?format=csv
Origin: {{origin}}


### Export starred — invalid format (expects 400)
GET {{baseUrl}}/api/export/starred?format=xml
Origin: {{origin}}