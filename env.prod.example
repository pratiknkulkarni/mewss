# mewss/env.prod.example
#
# For docker-compose.prod.yaml, which runs published images rather than
# building from source.
#
#   cp env.prod.example .env
#
# Every value below without a default is required; compose refuses to start if
# one is missing.

# ── Where the app is reachable ────────────────────────────────────────────────
# The URL you type into the browser. Use the LAN IP of the machine running the
# stack (not localhost) if you want to reach it from other machines, and keep
# the port in sync with MEWSS_PORT below.
#
# Session cookies and Better Auth's trusted-origin check are both derived from
# this, so a mismatch shows up as login silently failing.
MEWSS_PUBLIC_URL=http://192.168.1.10:8080

# Host port the client is published on.
MEWSS_PORT=8080

# ── Images ────────────────────────────────────────────────────────────────────
MEWSS_REGISTRY=gitea.15092021.xyz
MEWSS_NAMESPACE=pratik
# "latest" tracks main. Pin to main-<short sha> to hold a known-good build.
MEWSS_TAG=latest

# ── Postgres ──────────────────────────────────────────────────────────────────
POSTGRES_USER=mewss_user
POSTGRES_PASSWORD=          # required — generate with: openssl rand -hex 24
POSTGRES_DB=mewss

# ── Secrets ───────────────────────────────────────────────────────────────────
# Required. Generate each with: openssl rand -hex 32
BETTER_AUTH_SECRET=
INTERNAL_API_SECRET=

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info            # debug | info | warn | error
APPLICATION_NAME=mewss_api
